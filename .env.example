# Every value is OPTIONAL. With no .env at all the engine runs on the deterministic
# stub classifier and stub language model, which is also what the tests use.

# ── Decisions ──────────────────────────────────────────────────────────────
# Routing, domain-fit and resolution checks. If set (and langchain-typesafe is
# installed) they use Jev, a fast classifier that returns calibrated probabilities.
TYPESAFE_API_KEY=

# ── Language ───────────────────────────────────────────────────────────────
# Any LangChain model string: "openai:gpt-4o-mini", "ollama:llama3.2",
# "google_genai:gemini-2.0-flash". Install the provider package
# (`pip install -e ".[llm]" langchain-<provider>`) and set that provider's usual
# API key variable. Unset = stub.
LLM_MODEL=

# ── Storage ────────────────────────────────────────────────────────────────
# Set on Vercel automatically when a Blob store is attached. Locally, leave
# unset and tickets persist to runs/tickets.json.
BLOB_READ_WRITE_TOKEN=

# ── Real connectors (shape-only in this repo; raise ConnectorNotConfigured) ─
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
GITHUB_REPO=
GITHUB_TOKEN=
